# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma (Supabase Postgres)
# Use pooler (port 6543) with pgbouncer for DATABASE_URL
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use direct connection (port 5432) for migrations
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
# Optional: gemini-2.5-flash (default), gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Serviço de PDF (services/pdf)
# Obrigatória com NODE_ENV=production. Vazia em desenvolvimento desliga a autenticação.
PDF_API_KEY=
# Renderizações simultâneas (1 a 8). Pedidos além disso entram na fila.
RENDER_CONCURRENCY=2
# Pedidos em espera na fila (0 a 100). Fila cheia responde 503 com Retry-After: 5.
RENDER_QUEUE_MAX=10
# Só para rodar o serviço fora do Docker. A imagem já define /usr/bin/chromium.
# Não deixe a linha vazia no .env da VM: o Compose trocaria o caminho da imagem por vazio.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
